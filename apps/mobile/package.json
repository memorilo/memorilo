{
  "name": "@memorilo/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "android": "pnpm --workspace-root prepare:embedding-model && pnpm --workspace-root prepare:mobile-embedding-model && expo run:android",
    "build": "tsc -p tsconfig.json --noEmit",
    "dev": "pnpm --workspace-root prepare:embedding-model && pnpm --workspace-root prepare:mobile-embedding-model && expo start --dev-client",
    "export": "pnpm --workspace-root prepare:embedding-model && pnpm --workspace-root prepare:mobile-embedding-model && EXPO_NO_BUNDLE_SPLITTING=1 expo export --platform android --platform ios",
    "ios": "pnpm --workspace-root prepare:embedding-model && pnpm --workspace-root prepare:mobile-embedding-model && pnpm --workspace-root prepare:mobile-sqlite-vec && expo run:ios",
    "lint": "eslint .",
    "prebuild": "pnpm --workspace-root prepare:embedding-model && pnpm --workspace-root prepare:mobile-embedding-model && pnpm --workspace-root prepare:mobile-sqlite-vec && expo prebuild --no-install",
    "start": "expo start",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@expo/dom-webview": "57.0.1",
    "@expo/metro-runtime": "57.0.11",
    "@expo/vector-icons": "15.1.1",
    "@huggingface/tokenizers": "0.1.3",
    "@memorilo/application": "workspace:*",
    "@memorilo/config": "workspace:*",
    "@memorilo/editor": "workspace:*",
    "@memorilo/editor-storage": "workspace:*",
    "@memorilo/editor-storage-expo": "workspace:*",
    "@memorilo/effect-lifecycle": "workspace:*",
    "@memorilo/reading-model": "workspace:*",
    "@memorilo/shelf": "workspace:*",
    "@memorilo/srs": "workspace:*",
    "@noble/hashes": "2.2.0",
    "@zip.js/zip.js": "2.8.11",
    "expo": "57.0.14",
    "expo-asset": "57.0.12",
    "expo-constants": "57.0.12",
    "expo-crypto": "~57.0.1",
    "expo-file-system": "57.0.4",
    "expo-font": "57.0.1",
    "expo-glass-effect": "57.0.1",
    "expo-image-manipulator": "57.0.11",
    "expo-linking": "57.0.6",
    "expo-router": "57.0.14",
    "expo-secure-store": "~57.0.1",
    "expo-sqlite": "57.0.1",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "~57.0.2",
    "i18next": "^25.10.10",
    "loro-react-native": "1.10.3",
    "lucide-react": "^0.468.0",
    "onnxruntime-react-native": "1.24.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^15.7.4",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@stylexjs/babel-plugin": "0.19.0",
    "@stylexjs/stylex": "0.19.0",
    "@types/react": "^19.0.0",
    "typescript": "~6.0.3"
  }

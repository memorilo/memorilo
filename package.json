{
  "name": "@memorilo/workspace",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "author": "Memorilo contributors",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/memorilo/memorilo",
  "repository": {
    "type": "git",
    "url": "https://github.com/memorilo/memorilo.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@memorilo/desktop",
    "dev:mobile": "pnpm --filter @memorilo/mobile dev",
    "mobile:android": "pnpm --filter @memorilo/mobile android",
    "mobile:export": "pnpm --filter @memorilo/mobile export",
    "mobile:ios": "pnpm --filter @memorilo/mobile ios",
    "mobile:prebuild": "pnpm --filter @memorilo/mobile prebuild",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "prepare:embedding-model": "node scripts/prepare-embedding-model.mjs",
    "prepare:mobile-embedding-model": "node scripts/prepare-mobile-embedding-model.mjs",
    "prepare:mobile-sqlite-vec": "node scripts/prepare-mobile-sqlite-vec.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "test:e2e": "turbo run test:e2e --filter=@memorilo/desktop-e2e"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.19.0",
    "@eslint-react/eslint-plugin": "^1.38.4",
    "@huggingface/transformers": "3.7.5",
    "@types/node": "^22.15.30",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "turbo": "^2.5.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}

{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "esnext",
    "jsx": "preserve",
    "module": "esnext",
    "moduleResolution": "Bundler",

    "paths": {
      "@memorilo/ui/*": ["./src/*"],
      "@memorilo/utils": ["../utils/src/index.ts"],
      "@memorilo/utils/*": ["../utils/src/*"]
    },
    "resolveJsonModule": true,
    "allowJs": true,
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "noEmit": true,
    "sourceMap": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "../utils/src/cn.ts", "../../apps/client/src/components/auto-form"]

}

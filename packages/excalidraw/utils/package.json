{
  "name": "@excalidraw/utils",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "types": "./index.ts",
  "main": "./index.ts",
  "module": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./*": "./*"
  },
  "description": "Excalidraw utility functions",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "keywords": [
    "excalidraw",
    "excalidraw-utils"
  ],
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not ie <= 11",
      "not op_mini all",
      "not safari < 12",
      "not kaios <= 2.5",
      "not edge < 79",
      "not chrome < 70",
      "not and_uc < 13",
      "not samsung < 10"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@braintree/sanitize-url": "6.0.2",
    "@excalidraw/laser-pointer": "1.3.1",
    "@excalidraw/math": "workspace:*",
    "browser-fs-access": "0.29.1",
    "open-color": "1.9.1",
    "pako": "2.0.3",
    "points-on-curve": "1.0.1",
    "perfect-freehand": "1.2.0",
    "png-chunk-text": "1.0.0",
    "png-chunks-encode": "1.0.0",
    "png-chunks-extract": "1.0.0",
    "roughjs": "4.6.4"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "jest-diff": "29.7.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "bugs": "https://github.com/excalidraw/excalidraw/issues",
  "repository": "https://github.com/excalidraw/excalidraw"
}

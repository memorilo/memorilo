{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "memorilo",
  "version": "0.1.0",
  "identifier": "com.memorilo.client",
  "build": {
    "beforeDevCommand": "cd apps/client && pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "just build-web",
    "frontendDist": "../apps/client/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Memorilo",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "models/"
    ]
  }
}
